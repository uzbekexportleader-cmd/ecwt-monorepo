{
  "name": "ecwt",
  "version": "0.1.0",
  "private": true,
  "description": "ECWT — O'zbekiston Elektron Tijorat Kompaniyasi. Hunarmandlar uchun subsidiya va marketplace platformasi.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "phone": "node scripts/phone.mjs",
    "build:packages": "pnpm --filter \"@ecwt/types\" --filter \"@ecwt/config\" --filter \"@ecwt/validation\" --filter \"@ecwt/ui\" --filter \"@ecwt/api-client\" build",
    "dev": "concurrently -n db,api,admin -c cyan,green,magenta \"pnpm dev:db\" \"pnpm dev:api\" \"pnpm dev:admin\"",
    "dev:db": "pnpm --filter @ecwt/api dev:db",
    "dev:api": "pnpm --filter @ecwt/api dev",
    "dev:mobile": "pnpm --filter @ecwt/mobile start",
    "dev:admin": "pnpm --filter @ecwt/admin dev",
    "db:push": "pnpm --filter @ecwt/api db:push",
    "db:seed": "pnpm --filter @ecwt/api db:seed",
    "db:reset": "pnpm --filter @ecwt/api db:reset",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm build:packages && pnpm -r --workspace-concurrency=1 --filter \"./apps/*\" build",
    "setup": "pnpm install && pnpm build:packages && pnpm db:push && pnpm db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.9.2",
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "@eslint/js": "^9.36.0",
    "globals": "^15.15.0"
  }
}
