# ============================================================================
# ECWT — muhit o'zgaruvchilari namunasi
#
# Bu faylni nusxalab `.env` deb nomlang va qiymatlarni to'ldiring:
#   Copy-Item .env.example .env
#
# ⚠️  `.env` faylini HECH QACHON git'ga yuklamang — ичida maxfiy kalitlar bor.
# ============================================================================

NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL)
#
# Bepul variant: https://neon.tech — ro'yxatdan o'ting, loyiha yarating,
# "Connection string" ni shu yerga qo'ying.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:parol@ep-xxx.eu-central-1.aws.neon.tech/ecwt?sslmode=require"

# ---------------------------------------------------------------------------
# JWT kalitlari — IKKALASI HAR XIL bo'lishi SHART (kamida 32 belgi).
#
# Yangi kalit yaratish (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="bu-yerga-tasodifiy-48-baytli-kalit-qoying-1"
JWT_REFRESH_SECRET="bu-yerga-BOSHQA-tasodifiy-48-baytli-kalit-2"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Qaysi manzillardan API'ga murojaat qilish mumkin (vergul bilan)
# Ishlab chiqarishda faqat haqiqiy domeningizni qoldiring.
# ---------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ---------------------------------------------------------------------------
# To'lov tizimlari
#
# Bo'sh qoldirsangiz — o'sha tizim o'chirilgan holatda qoladi va
# klientdagi ro'yxatda ko'rinmaydi. Loyiha baribir ishga tushadi.
# ---------------------------------------------------------------------------

# Payme (Paycom) — https://business.payme.uz
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click — https://click.uz (merchant kabinet)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# Uzum Bank
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# Stripe — AQSH kompaniyasi ochilgach
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Fayl saqlash (mahsulot rasmlari) — S3 mos keluvchi xizmat
# Masalan: Cloudflare R2, Backblaze B2, AWS S3
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------
# SMS (telefon tasdiqlash uchun) — Eskiz.uz yoki Play Mobile
# ---------------------------------------------------------------------------
SMS_PROVIDER=NONE
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=4546

# ---------------------------------------------------------------------------
# Seed (boshlang'ich ma'lumot) uchun
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@ecwt.uz
SEED_ADMIN_PASSWORD=
# Namuna hamkor va mahsulot yaratish uchun 1 qiling (faqat development)
SEED_DEMO=0

# ---------------------------------------------------------------------------
# Frontend (apps/web) — bu qiymatlar brauzerga ham ketadi, maxfiy emas
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Mobil ilova (apps/mobile)
#
# ⚠️ Telefonni USB emas, Wi-Fi orqali sinaganda "localhost" ishlamaydi —
# kompyuteringizning lokal IP manzilini yozing, masalan http://192.168.1.5:4000/api
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# ChatGPT — saytdagi o'ng pastki burchakdagi suhbat oynasi
#
# ChatGPT'ni ishlatib turgan modellarga (GPT-4o va h.k.) ulanish uchun
# kalit OpenAI'dan olinadi — ChatGPT ham, bu API ham bitta kompaniyaniki,
# alohida "ChatGPT kaliti" degan narsa yo'q.
#
# Kalitni oling: https://platform.openai.com/api-keys
# Kalit FAQAT serverda qoladi — brauzerga hech qachon yuborilmaydi.
# Bo'sh qoldirsangiz sayt ishlayveradi, faqat suhbat oynasi
# "hali ulanmagan" deb yozadi.
#
# ⚠️ Bu manzil ochiq: har bir savol sizning hisobingizdan pul yechadi.
# Kodda uchta chegara bor (xabar uzunligi, suhbat uzunligi va bitta
# IP dan 10 daqiqada 25 ta so'rov), lekin OpenAI kabinetida ham
# oylik limit qo'yishni tavsiya qilaman.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Ixtiyoriy. Standart: gpt-4o-mini (arzon va tez)
OPENAI_MODEL=gpt-4o-mini
