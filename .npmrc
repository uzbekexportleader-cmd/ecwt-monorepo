# Expo (React Native) monorepo ichida symlink bilan ishlamaydi —
# shuning uchun paketlarni tekis (hoisted) joylashtiramiz.
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false

# Sekin/beqaror ulanishda katta paketlar (react-native, next-swc, sharp)
# yuklanmay qolishi mumkin. Kutish vaqti va urinishlar sonini oshiramiz.
fetch-timeout=900000
fetch-retries=8
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
# Bir vaqtda kam yuklash — katta paketlar (react-native, next) uchun
# butun tezlik ularga qoladi va vaqt tugab qolmaydi.
network-concurrency=2
child-concurrency=2
