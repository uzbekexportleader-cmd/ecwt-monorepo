# API manzili.
#
# ODATDA BU YERNI TO'LDIRISH SHART EMAS.
# Bo'sh qoldirilsa, ilova Expo Go qaysi kompyuterga ulangan bo'lsa,
# o'sha IP ni avtomatik oladi (masalan http://192.168.100.5:4000/api).
# Shu sababli real telefonda hech narsa sozlamasdan ishlaydi.
#
# Faqat maxsus holatda (masalan API boshqa serverda) to'ldiring:
# EXPO_PUBLIC_API_URL=https://api.ecwt.uz/api
EXPO_PUBLIC_API_URL=

# Sentry (xatolarni kuzatish). Bo'sh bo'lsa — o'chiq.
# Sentry.io -> Create Project -> React Native -> DSN ni shu yerga qo'ying.
EXPO_PUBLIC_SENTRY_DSN=
