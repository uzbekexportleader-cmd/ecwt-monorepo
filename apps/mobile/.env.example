# ============================================================================
# ECWT mobil ilova — muhit o'zgaruvchilari namunasi
#
# Bu faylni nusxalab `.env` deb nomlang:
#   Copy-Item .env.example .env
#
# `EXPO_PUBLIC_` prefiksi MUHIM: usiz Expo o'zgaruvchini ilovaga
# umuman uzatmaydi. Ayni paytda bu prefiks qiymat ilova ichiga
# ochiq holda tushishini ham bildiradi — bu yerga maxfiy kalit
# YOZMANG.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend manzili.
#
# ⚠️ Telefonda sinaganda "localhost" ISHLAMAYDI — telefon uchun
#    "localhost" bu telefonning O'ZI degani, kompyuteringiz emas.
#    Kompyuteringizning lokal IP manzilini yozing.
#
#    Windows'da IP ni bilish:
#      ipconfig    ->  "IPv4 Address" qatoriga qarang
#
#    Telefon va kompyuter BITTA Wi-Fi tarmog'ida bo'lishi shart.
# ---------------------------------------------------------------------------

# Emulyator/simulyatorda ishlaganda:
# EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Haqiqiy telefonda ishlaganda (o'z IP manzilingizni qo'ying):
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000/api
