{
  "name": "@ecwt/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ECWT mobil ilova — hamkorlar uchun (iOS + Android)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "echo \"Mobil ilova EAS orqali quriladi: pnpm --filter @ecwt/mobile eas:build\"",
    "eas:build": "eas build --platform all --profile preview",
    "typecheck": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "clean": "rimraf .expo"
  },
  "dependencies": {
    "@ecwt/contracts": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-image": "~3.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-linking": "~8.0.0",
    "expo-localization": "~17.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-video": "~3.0.16",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
