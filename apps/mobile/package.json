{
  "name": "@ecwt/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src --max-warnings=0",
    "test": "jest --passWithNoTests",
    "build": "expo export --platform android --output-dir dist",
    "build:web": "expo export --platform web --output-dir dist-web",
    "eas-build-post-install": "cd ../.. && pnpm build:packages"
  },
  "dependencies": {
    "@ecwt/api-client": "workspace:*",
    "@ecwt/config": "workspace:*",
    "@ecwt/types": "workspace:*",
    "@ecwt/ui": "workspace:*",
    "@ecwt/validation": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/tinos": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "^57.0.4",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "expo-video": "^57.0.3",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.63.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "4.7.3",
    "react-native-vision-camera-face-detector": "1.10.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "1.6.3",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "57.0.10",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "esModuleInterop": true,
            "module": "CommonJS",
            "moduleResolution": "Node",
            "strict": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^expo-localization$": "<rootDir>/src/__mocks__/expo-localization.ts",
      "^expo-secure-store$": "<rootDir>/src/__mocks__/expo-secure-store.ts",
      "^react-native$": "<rootDir>/src/__mocks__/react-native.ts",
      "^expo-constants$": "<rootDir>/src/__mocks__/expo-constants.ts",
      "^expo-device$": "<rootDir>/src/__mocks__/expo-device.ts",
      "^expo-notifications$": "<rootDir>/src/__mocks__/expo-notifications.ts",
      "^@sentry/react-native$": "<rootDir>/src/__mocks__/sentry-react-native.ts",
      "^@react-native-community/netinfo$": "<rootDir>/src/__mocks__/netinfo.ts"
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts"
    ]
  }
}
