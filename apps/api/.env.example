# ---------- Umumiy ----------
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------- Ma'lumotlar bazasi ----------
# Lokal dev: `pnpm dev:db` PGlite serverni 5432 portda ko'taradi.
# Production: real PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# ---------- JWT ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---------- SMS provider ----------
# mock | eskiz | playmobile
SMS_PROVIDER=mock
# Dev rejimida OTP kodini API javobida qaytarish (productionda ALBATTA false)
EXPOSE_DEV_OTP=true
# Elektron imzo (didox.uz). Bo‘sh bo‘lsa shartnoma qo‘lda imzolanadi.
ESIGN_API_URL=
ESIGN_API_KEY=
ESIGN_TIN=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# Yuboruvchi nomi: moderatsiyagacha 4546 (Eskiz sinov raqami)
ESKIZ_FROM=4546
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_BASE_URL=

# ---------- Shaxsni tasdiqlash (OneID) ----------
# mock | oneid   —  real credential bo'lmaguncha mock
IDENTITY_PROVIDER=mock
ONEID_BASE_URL=https://sso.egov.uz/sso/oauth/Authorization.do
ONEID_CLIENT_ID=
ONEID_CLIENT_SECRET=
ONEID_REDIRECT_URI=

# ---------- Elektron imzo (E-IMZO) ----------
# mock | eimzo
SIGNATURE_PROVIDER=mock
EIMZO_BASE_URL=
EIMZO_API_KEY=

# ---------- Davlat reyestrlari ----------
# mock | real
REGISTRY_PROVIDER=mock
TAX_REGISTRY_BASE_URL=
TAX_REGISTRY_API_KEY=
HUNARMAND_REGISTRY_BASE_URL=
HUNARMAND_REGISTRY_API_KEY=

# ---------- Fayl saqlash ----------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Marketplace ----------
# mock | real  — real credential bo'lmaguncha mock
MARKETPLACE_PROVIDER=mock
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# ---------- AI assistant ----------
# mock | openai | anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Seed ----------
# DIQQAT: productionda SEED_ADMIN_PASSWORD shu standart qiymatda qolsa,
# seed skripti ishga tushmaydi (xavfsizlik tekshiruvi — prisma/seed.ts).
SEED_ADMIN_PHONE=998900000001
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_USER_PHONE=998901234567

# ---------- Boshqa ----------
BHM=412000

# Ulanishlar pooli (PGlite dev bazasi uchun 1, real Postgres uchun 10-20)
DATABASE_POOL_MAX=5

# Cheklovlar. Bo‘sh qoldirilsa: development = yumshoq, production = qat’iy.
# OTP_RESEND_COOLDOWN_SEC=60
# OTP_HOURLY_LIMIT=5
# RATE_LIMIT_PER_MINUTE=60

# ECWT shartnoma namunasi — imzolash uchun foydalanuvchi yuklab oladi
CONTRACT_TEMPLATE_PATH=./assets/contracts/ECWT-shartnoma.pdf

# ---------- Telegram ogohlantirish ----------
# Ro'yxatdan o'tish tugaganda mutaxassisga xabar boradi.
# Token: Telegramda @BotFather -> /newbot
# Chat ID: botga /start yozing, keyin @userinfobot ID beradi.
# Ikkalasi bo'sh bo'lsa — mock rejim, xabar yuborilmaydi (ariza bazada saqlanadi).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Sentry (xatolarni kuzatish) ----------
# Bo'sh qoldirilsa Sentry o'chiq holda ishlaydi — lokal dev uchun shunday.
# DSN olish: sentry.io -> Projects -> Create Project -> Node.js
SENTRY_DSN=
# Tranzaksiyalarning qancha qismi yig'iladi (0..1). Productionda 0.1 yetarli.
SENTRY_TRACES_SAMPLE_RATE=0.1
